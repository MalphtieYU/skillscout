{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MalphtieYU/skillscout/blob/main/data/plugin-registry.schema.json",
  "title": "SkillScout Plugin Registry Entry",
  "description": "An extensible local representation of a future Codex plugin directory entry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "description_en", "categories", "required_permissions", "read_actions", "write_actions", "best_for", "not_for", "complexity_level", "risk_level", "setup_difficulty", "examples", "last_updated", "source_url"],
  "properties": {
    "id": {"type":"string","minLength":1},
    "name": {"type":"string","minLength":1},
    "type": {"type":"string","enum":["skill","app","plugin","mcp","template"]},
    "description_en": {"type":"string","minLength":1},
    "description_zh": {"type":"string"},
    "categories": {"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "required_permissions": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "read_actions": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "write_actions": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "best_for": {"type":"array","minItems":1,"items":{"type":"string"}},
    "not_for": {"type":"array","minItems":1,"items":{"type":"string"}},
    "complexity_level": {"type":"integer","minimum":1,"maximum":5},
    "risk_level": {"type":"integer","minimum":0,"maximum":3},
    "setup_difficulty": {"type":"integer","minimum":0,"maximum":3},
    "examples": {"type":"array","minItems":1,"items":{"type":"string"}},
    "last_updated": {"type":"string","format":"date"},
    "source_url": {"type":"string","format":"uri"}
  }
}
